# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=digitalcards
DATABASE_PASSWORD=digitalcards_dev
DATABASE_NAME=digitalcards
DATABASE_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET_MEDIA=digitalcards-media
S3_BUCKET_QR=digitalcards-qr
S3_BUCKET_EXPORTS=digitalcards-exports

# Stripe
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-secret
STRIPE_PUBLISHABLE_KEY=pk_test_your-key

# Email (Resend)
RESEND_API_KEY=re_your-key
EMAIL_FROM=noreply@digitalcards.io

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your-sid
TWILIO_AUTH_TOKEN=your-token
TWILIO_PHONE_NUMBER=+1234567890

# Shipping (Shippo)
SHIPPO_API_KEY=your-shippo-key

# Cloudflare
CLOUDFLARE_API_TOKEN=your-cf-token
CLOUDFLARE_ZONE_ID=your-zone-id

# Sentry
SENTRY_DSN=https://your-sentry-dsn

# App URLs
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
SHORT_LINK_BASE_URL=http://localhost:3000/s
